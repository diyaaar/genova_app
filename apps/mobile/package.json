{
  "name": "@genova/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "tsc --noEmit && jest",
    "bundle:check": "expo export --platform ios --output-dir .expo/bundle-check --clear"
  },
  "dependencies": {
    "@dariyd/react-native-pdf-page-image": "2.0.0",
    "@shopify/react-native-skia": "2.6.2",
    "@supabase/supabase-js": "2.115.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-url-polyfill": "2.0.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../../lib/$1"
    },
    "clearMocks": true,
    "restoreMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
