{
  "name": "@genova/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "tsc --noEmit && jest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "expo": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-url-polyfill": "2.0.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "~19.2.2",
    "jest": "30.5.1",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@shared/(.*)$": "<rootDir>/../../lib/$1"
    },
    "clearMocks": true,
    "restoreMocks": true,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  }
}
